{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 4,

  "modules-left": ["custom/launcher", "custom/browser"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "disk", "battery", "tray", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip": "Applications",
    "on-click": "cosmic-app-library"
  },

  "custom/browser": {
    "format": "",
    "tooltip": "Firefox",
    "on-click": "firefox"
  },

  "clock": {
    "format": " {:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {used:0.1f}G" },
  "disk": { "format": " {used}" },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "network": {
    "format-wifi": "  {essid:.15} ⇣{bandwidthDownBytes:>6} ⇡{bandwidthUpBytes:>6}",
    "format-ethernet": "  {ipaddr} ⇣{bandwidthDownBytes:>6} ⇡{bandwidthUpBytes:>6}",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}\n{essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "interval": 3
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "tray": { "spacing": 8 },
  "custom/power": { "format": "⏻", "on-click": "wlogout" }
}
